# =====================================================================
# T'AAN - plantilla de configuración local
#
# 1. Copia este archivo como ".env" en esta misma carpeta.
# 2. Ajusta los valores a TU máquina.
#
# ".env" está en .gitignore y NUNCA se sube al repositorio: cada
# integrante del equipo tiene el suyo con sus propios valores.
#
# Este archivo lo lee "docker compose" automáticamente. IntelliJ NO lo
# lee: las variables del backend (TAAN_JWT_SECRETO, TAAN_ADMIN_PASSWORD,
# y DB_PORT si lo cambiaste) se definen en la Run Configuration.
# =====================================================================

# Puerto de PostgreSQL en tu máquina. Déjalo en 5432 salvo que ya tengas
# otro PostgreSQL instalado usando ese puerto (en ese caso usa 5433 y
# define también DB_PORT=5433 en la Run Configuration de IntelliJ).
DB_PORT=5432
